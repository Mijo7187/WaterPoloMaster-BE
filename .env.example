# ============================================
# ENVIRONMENT VARIABLES EXAMPLE
# ============================================
# This file is a TEMPLATE for your .env file
# Copy this file and rename it to ".env"
# Then fill in your actual values
#
# IMPORTANT: .env is in .gitignore (not shared)
#            .env.example IS shared (no secrets here)
# ============================================

# ============================================
# APPLICATION SETTINGS
# ============================================
# Environment: development, production, or testing
APP_ENV=development

# Application name
APP_NAME=WaterPoloMaster

# API version
API_VERSION=v1

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL example:
# DATABASE_URL=postgresql://username:password@localhost:5432/waterpolo_db
#
# MySQL example:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/waterpolo_db
#
# SQLite example (for development):
# DATABASE_URL=sqlite:///./waterpolo.db

DATABASE_URL=sqlite:///./waterpolo.db

# ============================================
# SECURITY SETTINGS
# ============================================
# Secret key for JWT tokens (generate a random string)
# You can generate one with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production

# Algorithm for JWT encoding
ALGORITHM=HS256

# Token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# SERVER SETTINGS
# ============================================
# Host to run the server on
HOST=0.0.0.0

# Port to run the server on
PORT=8000

# Enable auto-reload in development
RELOAD=True
